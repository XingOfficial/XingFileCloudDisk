<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 密码保护开关 -->
    <android.widget.CheckBox
        android:id="@+id/checkSharePassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="启用密码保护"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <!-- 密码输入框 -->
    <EditText
        android:id="@+id/inputSharePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入分享密码"
        android:inputType="textPassword"
        android:enabled="false"
        android:layout_marginBottom="16dp" />

    <!-- 有效期设置 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="分享有效期"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radioExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioExpiryNever"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="永久有效"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioExpiry1Day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1天" />

        <RadioButton
            android:id="@+id/radioExpiry7Day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7天" />

        <RadioButton
            android:id="@+id/radioExpiry30Day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30天" />

    </RadioGroup>

</LinearLayout>