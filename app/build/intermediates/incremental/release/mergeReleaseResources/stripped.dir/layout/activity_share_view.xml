<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Xing云盘 分享"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 手动输入分享 token 的入口：真正的 https 分享链接要唤起本 App 需要网站配合
             Android App Links 的域名验证，这里作为兜底方案，也支持手动粘贴 token。 -->
        <LinearLayout
            android:id="@+id/tokenInputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <EditText
                android:id="@+id/inputToken"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="粘贴分享 token 或链接" />

            <Button
                android:id="@+id/btnLoadShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看"
                android:backgroundTint="@color/seal"
                android:textColor="@color/app_white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card"
            android:padding="20dp"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#EFEAE0">

                <ImageView
                    android:id="@+id/previewImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/previewIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="文件"
                    android:textSize="34sp"
                    android:visibility="gone" />
            </FrameLayout>

            <Button
                android:id="@+id/btnPlayAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="▶ 播放音频"
                android:backgroundTint="@color/line"
                android:textColor="@color/ink"
                android:visibility="gone" />

            <TextView
                android:id="@+id/filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/ink"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="下载文件"
                android:backgroundTint="@color/seal"
                android:textColor="@color/app_white" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/ink_soft" />

    </LinearLayout>
</ScrollView>
